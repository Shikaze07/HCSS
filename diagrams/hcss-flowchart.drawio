<mxfile host="app.diagrams.net">
  <diagram id="hcss-flow" name="HCSS Flowchart">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1550" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="start" value="Start" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="460" y="20" width="80" height="40" as="geometry"/></mxCell>
        <mxCell id="n1" value="Login / Register" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="400" y="90" width="200" height="50" as="geometry"/></mxCell>
        <mxCell id="d1" value="Role?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="410" y="170" width="180" height="90" as="geometry"/></mxCell>

        <mxCell id="c1" value="Client Dashboard" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="40" y="320" width="200" height="50" as="geometry"/></mxCell>
        <mxCell id="c2" value="Booking Management: select Service, Date, Start Time and pin Address on map" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="40" y="410" width="200" height="70" as="geometry"/></mxCell>
        <mxCell id="c3" value="Booking saved with status PENDING" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="40" y="520" width="200" height="50" as="geometry"/></mxCell>

