        <mxCell id="a2" value="Booking Management: review bookings" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="400" y="520" width="200" height="50" as="geometry"/></mxCell>
        <mxCell id="a3" value="Approve?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="410" y="610" width="180" height="90" as="geometry"/></mxCell>
